{
  "name": "@altrudev/calibration-studio",
  "version": "0.11.0-alpha.2",
  "private": true,
  "description": "Calibration Studio core with universal adapters, deterministic lifecycle, Intent IR, a Codespaces-served visual Studio, release integrity, and an optional private DDC provider boundary.",
  "license": "UNLICENSED",
  "bin": {
    "calibrate": "bin/calibrate-entry.js",
    "ddc-intent": "bin/intent.js"
  },
  "scripts": {
    "start": "node bin/studio-launch.js",
    "studio": "node bin/studio-launch.js",
    "studio:server": "node bin/studio.js --no-open",
    "check": "node scripts/check-source.js",
    "test": "node --test tests/*.test.js",
    "gate": "node scripts/validate-local.js",
    "gate:all": "node scripts/validate-local.js --all",
    "gate:security": "node scripts/validate-local.js --security",
    "gate:supply-chain": "node scripts/validate-local.js --supply-chain",
    "gate:runtime": "node scripts/validate-local.js --runtime",
    "perun": "node scripts/perun.js",
    "perun:offline": "node scripts/perun.js --offline",
    "github-app": "node bin/github-app.js",
    "github-worker": "node bin/github-worker.js",
    "runtime:install-browser": "node src/runtime/install-browser.js",
    "runtime:verify-browser": "node src/runtime/verify-browser.js",
    "adapters": "node bin/calibrate-entry.js adapters",
    "version:product": "node bin/calibrate-entry.js version"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
