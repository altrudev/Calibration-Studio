{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altru.dev/schemas/calibration-evaluator-predictions-0.1.schema.json",
  "title": "Calibration evaluator predictions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "corpus_id",
    "evaluator",
    "runs"
  ],
  "properties": {
    "protocol": {
      "const": "calibration-evaluator-predictions/0.1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "run_id",
          "decision",
          "severity"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "pass",
              "pass_with_limitations",
              "fail",
              "inconclusive",
              "not_assessed"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "none",
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
