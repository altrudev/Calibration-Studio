{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altru.dev/calibration/schemas/calibration-api-plan-0.5.schema.json",
  "title": "Calibration Studio API Plan 0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requests"],
  "$defs": {
    "headers": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "expectedStatus": {"oneOf": [{"type": "integer"}, {"type": "array", "items": {"type": "integer"}}]},
    "assertion": {
      "type": "object", "additionalProperties": false, "required": ["operator"],
      "properties": {
        "pointer": {"type": "string", "default": ""},
        "operator": {"enum": ["exists", "equals", "type", "length"]},
        "expected": {}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["id", "url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "method": {"enum": ["GET", "HEAD", "OPTIONS", "get", "head", "options"], "default": "GET"},
        "url": {"type": "string", "minLength": 1},
        "headers": {"$ref": "#/$defs/headers"},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "max_response_bytes": {"type": "integer", "minimum": 1024},
        "expected_status": {"$ref": "#/$defs/expectedStatus"},
        "expected_content_type": {"type": "string"},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}
      }
    }
  },
  "properties": {
    "protocol": {"const": "calibration-api-plan/0.5"},
    "requests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "default": "GET"},
          "url": {"type": "string", "minLength": 1},
          "headers": {"$ref": "#/$defs/headers"},
          "body": {},
          "timeout_ms": {"type": "integer", "minimum": 1},
          "max_response_bytes": {"type": "integer", "minimum": 1024},
          "expected_status": {"$ref": "#/$defs/expectedStatus"},
          "expected_content_type": {"type": "string"},
          "max_duration_ms": {"type": "integer", "minimum": 1},
          "allow_effectful": {"type": "boolean", "default": false},
          "verify": {"type": "array", "items": {"$ref": "#/$defs/verifier"}}
        }
      }
    }
  }
}
