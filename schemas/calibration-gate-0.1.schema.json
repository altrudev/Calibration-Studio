{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://altru.dev/calibration/schemas/calibration-gate-0.1.schema.json","title":"Calibration Studio gate artifact 0.1","type":"object","required":["schema","id","fingerprint","created_at","baseline","current","policy","decision","summary","regression","trace"],"properties":{"schema":{"const":"altru-calibration-gate/0.1"},"id":{"type":"string","pattern":"^GATE-[A-F0-9]{12}$"},"fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"created_at":{"type":"string"},"baseline":{"type":"object","required":["id","fingerprint","git_commit"]},"current":{"type":"object","required":["git_commit","regression_id","regression_fingerprint"]},"policy":{"type":"object","required":["fail_on_environment_change","fail_on_untracked_observations","trace_on_regression","trace_strategy","max_commits"]},"decision":{"type":"object","required":["status","exit_code","failure_codes","advisory_codes"],"properties":{"status":{"enum":["pass","fail"]},"exit_code":{"enum":[0,2]},"failure_codes":{"type":"array"},"advisory_codes":{"type":"array"}}},"summary":{"type":"object","required":["checked_count","stable_count","within_tolerance_count","drifted_count","missing_count","environment_changed_count","untracked_observation_count"]},"regression":{"type":"object"},"trace":{"type":["object","null"]}},"additionalProperties":false}
