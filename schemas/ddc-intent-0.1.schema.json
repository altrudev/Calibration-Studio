{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altru.dev/schemas/ddc-intent-0.1.schema.json",
  "title": "DDC Intent IR v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["intent_id", "clauses"],
  "properties": {
    "protocol": {"const": "ddc-intent/0.1"},
    "intent_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "label": {"type": ["string", "null"]},
    "scope": {"type": "object", "properties": {"id": {"type": "string"}, "parents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false},
    "clauses": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "target", "operator"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["goal", "invariant", "preference", "prohibition", "assumption", "acceptance"]}, "target": {"type": "string", "minLength": 1}, "operator": {"enum": ["eq", "neq", "gte", "lte", "contains", "not_contains", "exists", "not_exists", "preserve"]}, "value": {}, "severity": {"enum": ["hard", "soft"]}, "priority": {"type": "number", "minimum": 0, "maximum": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "scope": {"type": "string"}, "overrides": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "provenance": {"type": "object", "properties": {"type": {"type": "string"}, "ref": {"type": ["string", "null"]}, "statement": {"type": ["string", "null"]}}, "additionalProperties": false}}, "additionalProperties": false}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "relation"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "relation": {"enum": ["affects", "requires", "constrains", "protects", "derived_from", "conflicts_with"]}}, "additionalProperties": false}},
    "metadata": {"type": "object"}
  }
}
