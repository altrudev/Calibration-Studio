{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://altru.dev/calibration/schemas/calibration-trace-0.1.schema.json","title":"Calibration Studio historical trace 0.1","type":"object","required":["schema","id","fingerprint","created_at","baseline","repository","range","trace","affected_checks","evaluations"],"properties":{"schema":{"const":"altru-calibration-trace/0.1"},"id":{"type":"string","pattern":"^TRACE-[A-F0-9]{12}$"},"fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"created_at":{"type":"string"},"baseline":{"type":"object","required":["id","fingerprint"]},"repository":{"type":"object","required":["name","github_url"]},"range":{"type":"object","required":["good_commit","bad_commit","commit_count","history_mode","strategy"],"properties":{"strategy":{"enum":["exact","binary"]},"history_mode":{"const":"first-parent"}}},"trace":{"type":"object","required":["status","evaluated_count","guarantee","first_bad_index","last_good_index"],"properties":{"status":{"enum":["first_bad_found","no_active_regression"]},"guarantee":{"enum":["first-parent-exact","monotonic-regression-assumption"]}}},"last_good":{"type":["object","null"]},"first_bad":{"type":["object","null"]},"affected_checks":{"type":"array"},"evaluations":{"type":"array","minItems":1}},"additionalProperties":false}
