{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altru.dev/schemas/calibration-evaluator-cases-0.1.schema.json",
  "title": "Calibration evaluator case corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "cases"
  ],
  "properties": {
    "protocol": {
      "const": "calibration-evaluator-cases/0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "blinded",
              "retrospective"
            ]
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
