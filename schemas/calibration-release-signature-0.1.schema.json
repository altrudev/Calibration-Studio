{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://altru.dev/calibration/schemas/calibration-release-signature-0.1.schema.json","title":"Calibration Studio release signature 0.1","type":"object","required":["schema","algorithm","release_id","manifest_fingerprint","signature"],"properties":{"schema":{"const":"altru-calibration-release-signature/0.1"},"algorithm":{"const":"Ed25519"},"release_id":{"type":"string","pattern":"^RELEASE-[A-F0-9]{12}$"},"manifest_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"signature":{"type":"string","minLength":40}},"additionalProperties":false}
