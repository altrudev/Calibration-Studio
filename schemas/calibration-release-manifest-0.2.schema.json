{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://altru.dev/calibration/schemas/calibration-release-manifest-0.2.schema.json","title":"Calibration Studio release manifest 0.2","description":"Standalone release payload manifest. created_at is metadata and is intentionally excluded from the deterministic payload fingerprint.","type":"object","required":["schema","created_at","product","version","platform","arch","runtime","files","id","fingerprint"],"properties":{"schema":{"const":"altru-calibration-release-manifest/0.2"},"created_at":{"type":"string"},"product":{"const":"Calibration Studio"},"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"},"platform":{"type":"string","minLength":1},"arch":{"type":"string","minLength":1},"runtime":{"type":["object","null"]},"files":{"type":"array","minItems":1,"items":{"type":"object","required":["path","size","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\./).+$"},"size":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},"id":{"type":"string","pattern":"^RELEASE-[A-F0-9]{12}$"},"fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}
